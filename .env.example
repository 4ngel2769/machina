# ---- Machina v2 core config ----
# Storage root: base images + guest disks(os) + seeds + vnc sockets + tmp
MACHINA_STORAGE_DIR=/mnt/machina
# SQLite file (dir is created if missing)
MACHINA_DB_PATH=/var/lib/machina/machina.db
# virsh connection (system daemon = real VMs)
VIRSH_URI=qemu:///system
# Control-plane HTTP listen
SERVER_PORT=3999

# Auth
AUTH_SECRET=            # openssl rand -hex 32
AUTH_TRUST_HOST=true
ADMIN_USER=admin
ADMIN_PASSWORD=         # set once; stored bcrypt on first boot
# Optional: 64 hex chars AES master key for ciphertext-at-rest; falls back
# to <dataDir>/machina.key generated on first boot (mode 0600).
MACHINA_MASTER_KEY=
