[Unit]
Description=machina guest-VM isolation firewall (virbr-machina0)
Documentation=file:///etc/nftables.d/machina-gfw.nft
After=network-online.target libvirtd.service
Wants=network-online.target

[Service]
Type=oneshot
# Destroy first so a re-run replaces the table instead of appending duplicates.
ExecStartPre=-/usr/sbin/nft destroy table inet machina_gfw
ExecStart=/usr/sbin/nft -f /etc/nftables.d/machina-gfw.nft
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
